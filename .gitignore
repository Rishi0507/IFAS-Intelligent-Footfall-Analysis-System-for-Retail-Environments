# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# Models (large binaries — download on demand)
models/
*.onnx
*.pt
*.pth

# Outputs (regenerate from runs)
outputs/*
!outputs/.gitkeep
# The 40-second demo run ships with the repo; every other run stays local.
!outputs/runs/
outputs/runs/*
!outputs/runs/djsce-cr22-3m00s-3m40s/
outputs/runs/djsce-cr22-3m00s-3m40s/stills/
!outputs/ann_frame_*.jpg

# Notebooks
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db

# Research datasets (licensed for research use; never commit or redistribute)
data/

# Footage and checkpoints (docs/research-data.md: footage and labels stay out of git)
checkpoints/
footage/
# Recordings dropped into the working tree: CCTV footage never goes into git,
# wherever it lands
*.avi
*.mp4
*.mkv
*.mov
*.dav
# except the 40-second demo run's two videos (see outputs/runs/ above)
!outputs/runs/djsce-cr22-3m00s-3m40s/video.mp4
!outputs/runs/djsce-cr22-3m00s-3m40s/clean.mp4
